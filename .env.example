# Copy thành .env.local (cùng thư mục) rồi điền giá trị thật. KHÔNG commit .env.local.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key - chỉ dùng phía server>

# AI miễn phí: tạo key tại https://aistudio.google.com/apikey
# Để trống -> chatbot dùng bộ dò từ khóa, không gọi mạng.
GEMINI_API_KEY=
# Tùy chọn: ép 1 model thử đầu tiên. Để trống = tự chọn (câu đơn giản: flash-lite; câu cần giải thích: 3.8-flash)
GEMINI_MODEL=

# Meme GIF mới từ GIPHY (miễn phí): https://developers.giphy.com/dashboard -> Create an App -> API
# Để trống -> dùng 4 meme SVG có sẵn.
GIPHY_API_KEY=
